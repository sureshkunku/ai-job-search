# Copy this file to .env and fill in your own values.
# NEVER put real keys in this file — it is meant to be committed.

# ── LLM ──────────────────────────────────────────────
# Get free at: https://console.groq.com  (API keys start with gsk_)
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Database ──────────────────────────────────────────
# Get free at: https://supabase.com → Project Settings → API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# ── Scraping ──────────────────────────────────────────
# Get free at: https://apify.com (free tier: 5 actors)
APIFY_API_TOKEN=apify_api_your_token_here
# Get free at: https://serpapi.com (100 searches/month free)
SERPAPI_KEY=your_serpapi_key_here

# ── Observability ─────────────────────────────────────
# Get free at: https://langfuse.com OR self-host
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Email ─────────────────────────────────────────────
# Get free at: https://sendgrid.com (100 emails/day free)
SENDGRID_API_KEY=your_sendgrid_key_here
EMAIL_FROM=your@email.com
EMAIL_TO=your@email.com

# ── App Settings ──────────────────────────────────────
APP_ENV=development          # development | staging | production
LOG_LEVEL=DEBUG
API_SECRET_KEY=change-this-to-random-string-in-prod
SCRAPE_INTERVAL_HOURS=6
MAX_JOBS_PER_RUN=200
MATCH_SCORE_THRESHOLD=75     # only email jobs above this score

# ── Your Resume (used for scoring) ───────────────────
# Path to your resume — .txt or .pdf both work
RESUME_FILE_PATH=./data/resume.pdf
